OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
EMBEDDING_PROVIDER=local
OPENAI_EMBED_BASE_URL=
OPENAI_EMBED_MODEL=text-embedding-3-small
CHROMA_PERSIST_DIR=./chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
MAX_RETRIES=2

# --- customer-service extension ------------------------------------------- #
# Answers with confidence < CONFIDENCE_THRESHOLD are replaced with the
# "未找到明确答案，建议转人工客服" template instead of being shown to the user.
CONFIDENCE_THRESHOLD=0.6
# When true, the generation prompt enforces a 参考来源 block and the
# hallucination check verifies every citation against the retrieved documents.
ENABLE_CITATION=true
# Default value for the `ask --show-trace` CLI flag.
SHOW_TRACE=false
